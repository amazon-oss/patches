From 5da8d1e52cbcbe74d624966d92e7cb5dc895c9a0 Mon Sep 17 00:00:00 2001
From: R0rt1z2 <roger@r0rt1z2.com>
Date: Sun, 8 Nov 2026 22:44:18 +0100
Subject: [PATCH] SetupWizard: Only disable the ATV setup wizard if it is
 installed

Disabling a package that is not installed throws, which crashes the
setup wizard on TV builds that ship without GMS.

Change-Id: I0d4c8ba047dca2c484d56a4da9d106629b8f07a3
---
 src/com/cyanogenmod/setupwizard/util/SetupWizardUtils.java | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/com/cyanogenmod/setupwizard/util/SetupWizardUtils.java b/src/com/cyanogenmod/setupwizard/util/SetupWizardUtils.java
index 8a92a61..c84db47 100644
--- a/src/com/cyanogenmod/setupwizard/util/SetupWizardUtils.java
+++ b/src/com/cyanogenmod/setupwizard/util/SetupWizardUtils.java
@@ -260,7 +260,8 @@ public class SetupWizardUtils {
         // Google's ATV SUW is shipped as it requires platform signature.
         // Disable it if GMS is not installed by user.
         if (hasLeanback(context) &&
-            !PackageManagerUtils.isAppInstalled(context, GMS_PACKAGE)) {
+            !PackageManagerUtils.isAppInstalled(context, GMS_PACKAGE) &&
+            PackageManagerUtils.isAppInstalled(context, GMS_TV_SUW_PACKAGE)) {
             disableApplication(context, GMS_TV_SUW_PACKAGE);
         }
     }
-- 
2.47.3

