From fe865588f3302c7e737afdcde3a241a3d50c3f4d Mon Sep 17 00:00:00 2001
From: Florian Schmidt <flo.schmidt10@gmail.com>
Date: Fri, 17 Apr 2026 11:38:01 +0200
Subject: [PATCH 1/1] Add FireOS keyboard key shortcuts

Change-Id: Ic56a7cdede8b256d1bcc321094d0f2eb5bbd164c
---
 .../inputmethod/leanback/LeanbackKeyboardController.java    | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/com/android/inputmethod/leanback/LeanbackKeyboardController.java b/src/com/android/inputmethod/leanback/LeanbackKeyboardController.java
index 93fc80d..6f37bf0 100644
--- a/src/com/android/inputmethod/leanback/LeanbackKeyboardController.java
+++ b/src/com/android/inputmethod/leanback/LeanbackKeyboardController.java
@@ -446,9 +446,11 @@ public class LeanbackKeyboardController implements LeanbackKeyboardContainer.Voi
             case KeyEvent.KEYCODE_DPAD_DOWN:
                 handled = onDirectionalMove(LeanbackKeyboardContainer.DIRECTION_DOWN);
                 break;
+            case KeyEvent.KEYCODE_MEDIA_REWIND:
             case KeyEvent.KEYCODE_BUTTON_X:
                 handleCommitKeyboardKey(Keyboard.KEYCODE_DELETE, null);
                 break;
+            case KeyEvent.KEYCODE_MEDIA_FAST_FORWARD:
             case KeyEvent.KEYCODE_BUTTON_Y:
                 handleCommitKeyboardKey(LeanbackKeyboardView.ASCII_SPACE, null);
                 break;
@@ -555,6 +557,10 @@ public class LeanbackKeyboardController implements LeanbackKeyboardContainer.Voi
                 }
                 mInputListener.onEntry(InputListener.ENTRY_TYPE_DISMISS, 0, null);
                 break;
+            case KeyEvent.KEYCODE_MEDIA_PLAY_PAUSE:
+                mInputListener.onEntry(InputListener.ENTRY_TYPE_ACTION, 0, null);
+                mInputListener.onEntry(InputListener.ENTRY_TYPE_DISMISS, 0, null);
+                break;
             default:
                 handled = false;
                 break;
-- 
